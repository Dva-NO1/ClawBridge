# Copy this file to `keystore.properties` (git-ignored) and fill in your own signing keystore details.
# See BUILD.md for `keytool` command to generate your own release keystore.
AGM_RELEASE_STORE_FILE=keystore/release.jks
AGM_RELEASE_STORE_PASSWORD=CHANGE_ME_STORE_PASSWORD
AGM_RELEASE_KEY_ALIAS=clawbridge
AGM_RELEASE_KEY_PASSWORD=CHANGE_ME_KEY_PASSWORD
