# ClawBridge Relay — Nginx Reverse Proxy Example (WSS + Let's Encrypt TLS)
#
# Usage:
#   1. Replace `relay.example.com` with your own domain (A record -> YOUR_VPS_IP)
#   2. Copy to `/etc/nginx/sites-available/clawbridge-relay.conf`
#   3. Enable: `sudo ln -s /etc/nginx/sites-available/clawbridge-relay.conf /etc/nginx/sites-enabled/`
#   4. Test & reload: `sudo nginx -t && sudo systemctl reload nginx`
#   5. Issue free Let's Encrypt certificate:
#        sudo certbot --nginx -d relay.example.com --email you@example.com --agree-tos --redirect

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name relay.example.com;

    # Let's Encrypt HTTP-01 challenge + automatic HTTPS redirect once certbot runs
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name relay.example.com;

    # Managed by Certbot (paths created automatically after `certbot --nginx`)
    ssl_certificate     /etc/letsencrypt/live/relay.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/relay.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # Allow chunked file/image artifact frames (up to 20 MB)
    client_max_body_size 20m;

    # Health check endpoint
    location = /healthz {
        proxy_pass http://127.0.0.1:8787/healthz;
        proxy_set_header Host $host;
    }

    # WebSocket Relay endpoint (wss://relay.example.com)
    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Keep persistent WSS connections alive cleanly across idle windows
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
}
