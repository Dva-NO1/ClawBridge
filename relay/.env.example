# ClawBridge Relay Environment Configuration Example
# Copy to `.env` (for local testing) or `/etc/clawbridge-relay/relay.env` (on VPS).

# Bind address (use 127.0.0.1 behind Nginx/Caddy TLS reverse proxy)
RELAY_HOST=127.0.0.1

# Internal HTTP/WebSocket listen port
RELAY_PORT=8787

# Persistent pairing & offline notification state file (chmod 600)
RELAY_STATE_FILE=/var/lib/clawbridge-relay/state.json

# Public domain pointed at your VPS (used by deploy.sh / reverse proxy)
RELAY_DOMAIN=relay.example.com

# Email for Let's Encrypt certificate expiration notices
CERTBOT_EMAIL=you@example.com
