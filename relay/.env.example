# ClawBridge Relay Environment Configuration (/etc/clawbridge-relay/relay.env)

# Listen address:
#   - 0.0.0.0 when using built-in IPv4 TLS (Domain-Free Public IP mode)
#   - 127.0.0.1 when behind Nginx / Caddy reverse proxy
RELAY_HOST=0.0.0.0

# Listen port:
#   - 8443 (recommended default for Domain-Free Public IPv4 WSS mode)
#   - 8787 (default internal port when behind Nginx / Caddy)
RELAY_PORT=8443

# Persistent pairing & offline notification state file (chmod 600)
RELAY_STATE_FILE=/var/lib/clawbridge-relay/state.json

# Optional native TLS certificate & private key for Domain-Free Public IPv4 WSS mode
# (Automatically generated by `sudo bash deploy.sh` without requiring any domain!)
RELAY_TLS_CERT=/etc/clawbridge-relay/tls/cert.pem
RELAY_TLS_KEY=/etc/clawbridge-relay/tls/key.pem
